rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Read-only leaderboard for the client
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Optional: client-side submissions path (only if you choose not to use Functions)
    // This demonstrates rule-based rate limiting and server-issued seed check.
    // If you use Cloud Functions/Admin SDK to write submissions, these rules won't apply
    // and you should keep write denied here.
    match /submissions/{submissionId} {
      allow read: if false;
      // Enforce App Check on submissions
      allow create: if request.auth != null && request.app != null;
      allow update, delete: if false;
    }

    // Per-user profile doc storing server-issued seed and last submission time.
    // Clients may read their own profile to obtain the seed but cannot write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
  }
}
