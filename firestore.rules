rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Read-only leaderboard for the client
    match /leaderboard/{docId} {
      allow read: if true;           // public reads
      allow write: if false;         // clients never write directly
    }

    // Optional: client-side submissions path (only if you choose not to use Functions)
    // This demonstrates rule-based rate limiting and server-issued seed check.
    // If you use Cloud Functions/Admin SDK to write submissions, these rules won't apply
    // and you should keep write denied here.
    match /submissions/{submissionId} {
      allow read: if false;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.difficulty in ['casual','master','expert','insane']
        && request.resource.data.userScore is number
        && request.resource.data.playedSeconds is number
        && request.resource.data.seed is number
        && request.resource.data.moves is list
        // Enforce 1 submission per 5 minutes using a per-user throttle doc
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastSubmitAt <= request.time - duration.value(5, 'm')
        // Require server-issued seed stored on user doc to match the submission's seed
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeSeed == request.resource.data.seed;

      allow update, delete: if false;
    }

    // Per-user profile doc storing server-issued seed and last submission time.
    // Clients may read their own profile to obtain the seed but cannot write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only backend (Functions/Admin SDK) updates seed/lastSubmitAt
    }
  }
}
